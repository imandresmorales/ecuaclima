# Copia este archivo como .env.local (excluido de git) y completa los valores.

# --- Asistente con IA (solo servidor: nunca lleva el prefijo VITE_) ---
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite)
# GEMINI_MODEL=

# --- Opcionales del frontend (estas sí llegan al navegador: nunca pongas secretos aquí) ---
# Usar el backend Express propio en lugar de llamar a Open-Meteo directamente
# VITE_API_URL=http://localhost:3001
# Forzar mostrar u ocultar el chat (por defecto: se muestra en Vercel y en `npm run dev` con clave)
# VITE_ENABLE_CHAT=true
