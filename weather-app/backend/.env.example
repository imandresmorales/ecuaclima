# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Puerto del servidor
PORT=3001

# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# Peticiones permitidas por IP cada 15 minutos
RATE_LIMIT_MAX=100

# Proxies de confianza delante del servidor (0 en local, 1 en la mayoría de hostings)
TRUST_PROXY=0
